inline fun +(a: Int, b: Int): Int {
    ir(a, b) { add }
}

inline fun -(a: Int, b: Int): Int {
    ir(a, b) { sub }
}

inline fun *(a: Int, b: Int): Int {
    ir(a, b) { mul }
}

inline fun /(a: Int, b: Int): Int {
    ir(a, b) { div }
}

inline fun ==(a: Int, b: Int): Boolean {
    ir(a, b) { cmpeq }
}

inline fun <(a: Int, b: Int): Boolean {
    ir(a, b) { cmplt }
}

inline fun <=(a: Int, b: Int): Boolean {
    ir(a, b) { cmple }
}

inline fun >(a: Int, b: Int): Boolean {
    ir(a, b) { cmpgt }
}

inline fun >=(a: Int, b: Int): Boolean {
    ir(a, b) { cmpge }
}